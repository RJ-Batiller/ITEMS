# Generate a unique value for each environment. Do not commit the real .env file.
SECRET_KEY=replace-with-a-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=items_db

# Use 0.0.0.0 when testing from another device or a mobile preview extension.
APP_HOST=127.0.0.1
APP_PORT=5000

# Keep debug disabled unless actively developing locally.
APP_DEBUG=true
SESSION_COOKIE_SECURE=false
