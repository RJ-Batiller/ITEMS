# Generate a unique value for each environment. Do not commit the real .env file.
SECRET_KEY=replace-with-a-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=items_app
DB_PASSWORD=
DB_NAME=items_db
DB_CONNECT_TIMEOUT=10
DB_CONNECT_RETRIES=3

# Used by seed_superadmin.py when creating the first account.
SUPERADMIN_USERNAME=superadmin1
SUPERADMIN_PASSWORD=choose-a-strong-password
SUPERADMIN_FULL_NAME=System Super Admin
SUPERADMIN_EMAIL=admin@mcc.edu.ph

# Use 0.0.0.0 when testing from another device or a mobile preview extension.
APP_HOST=127.0.0.1
APP_PORT=5000

# Keep debug disabled unless actively developing locally.
APP_DEBUG=false
# Set true only when the app is served through HTTPS.
APP_HTTPS=true
SESSION_COOKIE_SECURE=true
# Optional custom HTTPS domain. Leave blank to use the current deployment host.
APP_PUBLIC_URL=
